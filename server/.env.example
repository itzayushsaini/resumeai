# --- Required ---------------------------------------------------------
# MongoDB Atlas connection string (Atlas -> Connect -> Drivers).
# Replace <password> with your database user's password.
MONGODB_URI=

# Random secret used to sign sessions. Generated for you; keep it private.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# --- URLs (defaults are right for local development) ------------------
API_PORT=4000
CLIENT_URL=http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173

# --- AI (needed from Phase 3) -----------------------------------------
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Optional: social sign-in -----------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Optional: PDF export ---------------------------------------------
# Path to Chrome/Edge/Chromium. Auto-detected on Windows if left empty.
CHROME_PATH=
